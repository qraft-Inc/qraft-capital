# Copy to .env.local for local development. Set real values in the hosting provider.
# Never commit real credentials.

# Confirmed production domain (enables canonical URLs, sitemap entries and structured data)
NEXT_PUBLIC_SITE_URL=

# Lead routing (SMTP). The enquiry form stays disabled until HOST, FROM/USER and LEAD_TO_EMAIL are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Verified inbox that receives Qraft Capital enquiries
LEAD_TO_EMAIL=
